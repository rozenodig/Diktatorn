<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the release build's Electron processes under the hardened runtime: V8 needs
     to generate code; library validation only loads frameworks with the app's Team ID, and a
     self-signed certificate has none, so the app could not load Electron itself; and the hardened
     runtime blocks the microphone without audio-input. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
