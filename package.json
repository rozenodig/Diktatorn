{
  "name": "diktatorn",
  "productName": "Diktatorn",
  "version": "0.1.0",
  "description": "Local, Swedish-first dictation for macOS.",
  "author": "Hugo Rosenö <hugo@rozenodigital.com>",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p . && tsc -p src/renderer && mkdir -p dist/renderer && cp src/renderer/*.html src/renderer/*.css dist/renderer/",
    "build:native": "scripts/build-native.sh",
    "fetch-models": "node scripts/fetch-models.ts",
    "icons": "electron scripts/render-icons.ts",
    "bench": "node bench/run.ts",
    "bench:cleanup": "node bench/cleanup/run.ts",
    "start": "npm run build && scripts/dev.sh",
    "package": "npm run build:native && rm -rf dist && npm run build && node scripts/package.ts",
    "typecheck": "tsc -p . --noEmit && tsc -p src/renderer --noEmit && tsc -p bench",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "electron": "44.9.3",
    "typescript": "7.0.2"
  }
}
